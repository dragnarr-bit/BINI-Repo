{
  "components/common/footer": "<footer class=\"footer\" role=\"contentinfo\">\n    <div class=\"container\">\n\n        <!-- Logo -->\n        <div class=\"footer-logo\">\n            <img src=\"{{cdn 'assets/img/T&C/logomarkfooter.png'}}\" alt=\"{{settings.store_name}}\">\n        </div>\n\n        <!-- Navigate -->\n        <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"footer-webPages\">\n            <h3 class=\"footer-info-heading\">{{lang 'footer.navigate'}}</h3>\n            <ul class=\"footer-info-list\">\n                {{#each pages}}\n                    <li><a href=\"{{url}}\">{{name}}</a></li>\n                {{/each}}\n                <li><a href=\"{{urls.sitemap}}\">{{lang 'sitemap.page_title'}}</a></li>\n            </ul>\n        </article>\n\n        <!-- Categories -->\n        <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"footer-categories\">\n            <h3 class=\"footer-info-heading\">{{lang 'footer.categories'}}</h3>\n            <ul class=\"footer-info-list\">\n                {{#each categories}}\n                    <li><a href=\"{{url}}\">{{name}}</a></li>\n                {{/each}}\n            </ul>\n        </article>\n\n        <!-- Info -->\n        {{#if settings.address}}\n        <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"storeInfo\">\n            <h3 class=\"footer-info-heading\">{{lang 'footer.info'}}</h3>\n            <address>{{nl2br settings.address}}</address>\n            {{#if settings.phone_number}}\n                <strong>{{lang 'footer.call_us' phone_number=settings.phone_number}}</strong>\n            {{/if}}\n        </article>\n        {{/if}}\n\n        <!-- Newsletter -->\n        <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"newsletterSubscription\">\n            <h3>Subscribe to our newsletter</h3>\n            <p>Get the latest updates on new products and upcoming sales.</p>\n            <form action=\"#\" method=\"POST\">\n                <button type=\"submit\">Subscribe</button>\n            </form>\n        </article>\n        \n\n    </div>\n\n    {{#if theme_settings.show_powered_by}}\n    <div class=\"footer-copyright\">\n        <p class=\"powered-by\">\n            {{lang 'footer.powered_by'}} <a href=\"https://www.bigcommerce.com?utm_source=merchant&amp;utm_medium=poweredbyBC\" rel=\"nofollow\">BigCommerce</a>\n        </p>\n    </div>\n    {{/if}}\n    {{#if theme_settings.show_copyright_footer}}\n    <div class=\"footer-copyright\">\n        <p class=\"powered-by\">&copy; {{moment format=\"YYYY\"}} {{settings.store_name}}</p>\n    </div>\n    {{/if}}\n\n    {{{region name=\"ssl_site_seal--global\"}}}\n    <div class=\"footer-decor footer-decor--left\">\n        <img src=\"{{cdn 'assets/img/T&C/footerdecor2.png'}}\" alt=\"Decorative shape left\">\n    </div>\n    <div class=\"footer-decor footer-decor--right\">\n        <img src=\"{{cdn 'assets/img/T&C/footerdecor.png'}}\" alt=\"Decorative shape right\">\n    </div>\n    \n</footer>\n"
}
